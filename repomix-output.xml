                        </div>
                      </motion.div>
                    )}
                  </AnimatePresence>
                </div>
              );
            })}
          </div>

        </div>
      </section>

      {/* ══════════════════════════════════════════════════════════════
          БЛОК 10: ФИНАЛЬНЫЙ ЭКРАН ЗАХВАТА С ПОДАРКОМ (BOTTOM CTA)
